{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Cross-platform desktop shell for the official DeepSeek Harness Web application.",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "src/main.mjs",
  "files": [
    "src/main.mjs",
    "scripts/prepare-runtime.mjs",
    "resources"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "build": "pnpm --dir ../.. run build",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "package:dir": "pnpm run build && pnpm run prepare-runtime && electron-builder --dir",
    "package:win": "pnpm run build && pnpm run prepare-runtime && electron-builder --win nsis",
    "package:mac": "pnpm run build && pnpm run prepare-runtime && electron-builder --mac dmg",
    "package:mac-x64": "pnpm run build && pnpm run prepare-runtime && electron-builder --mac dmg --x64",
    "package:mac-arm64": "pnpm run build && pnpm run prepare-runtime && electron-builder --mac dmg --arm64",
    "package:all": "pnpm run build && pnpm run prepare-runtime && electron-builder --win nsis --mac dmg"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.deepseek.harness",
    "productName": "DeepSeek Harness",
    "artifactName": "DeepSeek-Harness-${version}-${os}-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "compression": "store",
    "asar": true,
    "directories": {
      "output": "../../release/desktop",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/runtime-launcher.cjs",
        "to": "runtime-launcher.cjs"
      },
      {
        "from": "resources/runtime-resolver.mjs",
        "to": "runtime-resolver.mjs"
      },
      {
        "from": "runtime.asar",
        "to": "runtime.asar"
      },
      {
        "from": "runtime.asar.unpacked/node_modules",
        "to": "runtime.asar.unpacked/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "DeepSeek-Harness-Setup-${version}-${os}-${arch}.${ext}",
      "include": "resources/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "useZip": true,
      "differentialPackage": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    },
    "mac": {
      "icon": "resources/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
